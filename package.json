{
  "name": "Vaizen-nunjucks-templates",
  "version": "1.0.0",
  "description": "Nunjucks templates for Vaizen website",
  "main": "build.js",
  "scripts": {
    "build": "node build.js",
    "watch": "nodemon --watch . -e njk,json,css,js --ignore output/ --ignore node_modules/ -x 'node build.js'",
    "sync": "browser-sync start --config bs-config.js",
    "dev": "npm-run-all build --parallel watch sync"
  },
  "keywords": [
    "nunjucks",
    "templates",
    "static-site"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "lucide": "^1.17.0",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "http-server": "^14.1.1",
    "nodemon": "^3.0.1",
    "npm-run-all": "^4.1.5"
  }
}
