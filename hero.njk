<section class="hero-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-7 col-xl-6 text-center text-lg-start">
                <div class="d-flex d-lg-none justify-content-center mb-4">
                    <img src="img/logo-mark.svg" alt="Vaizen" class="hero-logo-mark-mobile">
                </div>
                <h1 class="hero-heading mb-4">
                    {{ hero.line1 | default("License film &amp; TV.") }}<br>
                    <span class="hero-heading-accent">{{ hero.line2 | default("Done right.") }}</span>
                </h1>
                <p class="hero-sub mb-5 mx-auto mx-lg-0">{{ hero.description | default("The B2B marketplace where rights holders and distributors find each other - no spreadsheets, no cold emails.") }}</p>
                <div class="d-flex gap-3 flex-wrap justify-content-center justify-content-lg-start">
                    <button class="btn btn-brand btn-lg px-4 py-2" data-bs-toggle="modal" data-bs-target="#contactModal">Browse the catalog</button>
                    <button class="btn btn-hero-outline btn-lg px-4 py-2" data-bs-toggle="modal" data-bs-target="#contactModal">List your titles</button>
                </div>
                <div class="hero-stats d-flex gap-4 mt-5 flex-wrap justify-content-center justify-content-lg-start">
                    {% for stat in hero.stats %}
                    <div class="hero-stat-item {% if not loop.first %}hero-stat-divider{% endif %}">
                        <div class="hero-stat-value">{{ stat.value }}</div>
                        <div class="hero-stat-label">{{ stat.label }}</div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            <div class="col-lg-5 col-xl-6 d-none d-lg-flex align-items-center justify-content-center">
                <img src="img/logo-mark.svg" alt="Vaizen" class="hero-logo-mark">
            </div>
        </div>
    </div>
</section>
