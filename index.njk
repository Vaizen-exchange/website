{% extends "_layout.njk" %}

{% block content %}
    {% include "hero.njk" %}

    <!-- Stats Section -->
    <section class="stats">
        <div class="container">
            <div class="stats-grid">
                {% for stat in stats %}
                <div class="stat-item">
                    <h3>{{ stat.value }}</h3>
                    <p>{{ stat.label }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- How It Works -->
    <section class="how-it-works" id="how-it-works">
        <div class="container">
            <h2 class="section-title">How It Works</h2>
            <p class="section-subtitle">Three simple steps to start investing in creator brands</p>
            
            <div class="steps">
                {% for step in steps %}
                <div class="step">
                    <div class="step-icon">{{ step.number }}</div>
                    <h3>{{ step.title }}</h3>
                    <p>{{ step.description }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Featured Brands -->
    <section class="featured-brands" id="brands">
        <div class="container">
            <h2 class="section-title">Featured Creator Brands</h2>
            <p class="section-subtitle">Invest in high-potential content creators across multiple platforms</p>
            
            <div class="brand-grid">
                {% for brand in brands %}
                <div class="brand-card">
                    <div class="brand-header">
                        <div class="brand-avatar">{{ brand.avatar }}</div>
                        <div class="brand-name">{{ brand.name }}</div>
                        <div class="brand-category">{{ brand.category }}</div>
                    </div>
                    <div class="brand-body">
                        <div class="brand-stats">
                            <div class="stat">
                                <div class="stat-value">{{ brand.followers }}</div>
                                <div class="stat-label">Followers</div>
                            </div>
                            <div class="stat">
                                <div class="stat-value">{{ brand.monthlyViews }}</div>
                                <div class="stat-label">Monthly Views</div>
                            </div>
                        </div>
                        <p class="brand-description">{{ brand.description }}</p>
                        <div class="investment-info">
                            <div class="investment-row">
                                <span class="investment-label">Seeking:</span>
                                <span class="investment-value">{{ brand.seeking }}</span>
                            </div>
                            <div class="investment-row">
                                <span class="investment-label">Min. Investment:</span>
                                <span class="investment-value">{{ brand.minInvestment }}</span>
                            </div>
                            <div class="investment-row">
                                <span class="investment-label">Equity Offered:</span>
                                <span class="investment-value">{{ brand.equityOffered }}</span>
                            </div>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: {{ brand.fundedPercentage }}%;"></div>
                        </div>
                        <p style="text-align: center; margin-bottom: 1rem; color: #666; font-size: 0.9rem;">{{ brand.fundedPercentage }}% funded • {{ brand.daysLeft }} days left</p>
                        <button class="invest-button">Invest Now</button>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Benefits -->
    <section class="benefits" id="benefits">
        <div class="container">
            <h2 class="section-title">Why Invest in Creator Brands?</h2>
            <p class="section-subtitle">The future of media is creator-owned and investor-backed</p>
            
            <div class="benefits-grid">
                {% for benefit in benefits %}
                <div class="benefit-card">
                    <div class="benefit-icon">{{ benefit.icon }}</div>
                    <h3>{{ benefit.title }}</h3>
                    <p>{{ benefit.description }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
        <div class="container">
            <h2>Ready to Start Investing?</h2>
            <p>Join thousands of investors backing the next generation of media entrepreneurs</p>
            <div class="hero-buttons">
                <a href="#" class="btn-primary">Create Account</a>
                <a href="#" class="btn-secondary">List Your Brand</a>
            </div>
        </div>
    </section>
{% endblock %}
