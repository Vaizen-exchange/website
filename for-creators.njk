{% extends "_layout.njk" %}

{% block content %}
    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <h1>{{ page.hero.heading }}</h1>
            <p>{{ page.hero.description }}</p>
            <div class="hero-buttons">
                {% for button in page.hero.buttons %}
                <a href="{{ button.url }}" class="{{ button.class }}">{{ button.text }}</a>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Value Transfer Section -->
    <section class="how-it-works">
        <div class="container">
            <h2 class="section-title">{{ page.valueTransfer.title }}</h2>
            <p class="section-subtitle">{{ page.valueTransfer.subtitle }}</p>
            
            <div class="steps">
                {% for step in page.valueTransfer.steps %}
                <div class="step">
                    <div class="step-icon">{{ step.icon }}</div>
                    <h3>{{ step.title }}</h3>
                    <p>{{ step.description }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Benefits Section -->
    <section class="featured-brands">
        <div class="container">
            <h2 class="section-title">{{ page.benefits.title }}</h2>
            <p class="section-subtitle">{{ page.benefits.subtitle }}</p>
            
            <div class="benefits-grid">
                {% for benefit in page.benefits.items %}
                <div class="benefit-card">
                    <div class="benefit-icon">{{ benefit.icon }}</div>
                    <h3>{{ benefit.title }}</h3>
                    <p>{{ benefit.description }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- How It Works -->
    <section class="how-it-works" id="how-it-works">
        <div class="container">
            <h2 class="section-title">{{ page.howItWorks.title }}</h2>
            <p class="section-subtitle">{{ page.howItWorks.subtitle }}</p>
            
            <div class="steps">
                {% for step in page.howItWorks.steps %}
                <div class="step">
                    <div class="step-icon">{{ step.number }}</div>
                    <h3>{{ step.title }}</h3>
                    <p>{{ step.description }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Credibility Transfer -->
    <section class="benefits">
        <div class="container">
            <h2 class="section-title">{{ page.credibility.title }}</h2>
            <p class="section-subtitle">{{ page.credibility.subtitle }}</p>
            
            <div class="brand-grid" style="max-width: 900px; margin: 0 auto;">
                <div class="brand-card">
                    <div class="brand-body" style="padding: 2rem;">
                        {% for point in page.credibility.points %}
                        <div style="margin-bottom: 1.5rem;">
                            <h3 style="color: #667eea; margin-bottom: 0.5rem;">{{ point.title }}</h3>
                            <p style="color: #666;">{{ point.description }}</p>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
        <div class="container">
            <h2>Join Our Creator Network</h2>
            <p>Access funded campaigns and build brand equity for emerging businesses</p>
            <div class="hero-buttons">
                <a href="#" class="btn-primary">Join Now</a>
                <a href="#" class="btn-secondary">View Opportunities</a>
            </div>
        </div>
    </section>
{% endblock %}
