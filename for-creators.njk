{% extends "_layout.njk" %}

{% block content %}

    <!-- Hero -->
    <section class="hero-section brand-gradient text-white text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 col-xl-7">
                    <h1 class="hero-heading fw-bold mb-4">{{ page.hero.heading }}</h1>
                    <p class="hero-sub mb-5">{{ page.hero.description }}</p>
                    <div class="d-flex gap-3 justify-content-center flex-wrap">
                        {% for button in page.hero.buttons %}
                        <a href="{{ button.url }}" class="btn btn-light btn-lg px-5 py-3 fw-semibold brand-cta-btn">{{ button.text }}</a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- From Submission to Discovery -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title fw-bold mb-2">{{ page.valueTransfer.title }}</h2>
                <p class="section-sub text-muted">{{ page.valueTransfer.subtitle }}</p>
            </div>
            <div class="row row-cols-1 row-cols-md-3 g-4 justify-content-center">
                {% for step in page.valueTransfer.steps %}
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm text-center">
                        <div class="card-body p-4">
                            <div class="step-badge brand-gradient text-white mx-auto mb-4">{{ step.icon }}</div>
                            <h5 class="fw-semibold mb-3">{{ step.title }}</h5>
                            <p class="text-muted mb-0">{{ step.description }}</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Built for Rights Holders -->
    <section class="py-5 bg-white">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title fw-bold mb-2">{{ page.benefits.title }}</h2>
                <p class="section-sub text-muted">{{ page.benefits.subtitle }}</p>
            </div>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 justify-content-center">
                {% for benefit in page.benefits.items %}
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm text-center">
                        <div class="card-body p-4">
                            <div class="benefit-emoji mb-3">{{ benefit.icon }}</div>
                            <h5 class="fw-semibold mb-3">{{ benefit.title }}</h5>
                            <p class="text-muted mb-0">{{ benefit.description }}</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Submit in Four Steps -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title fw-bold mb-2">{{ page.howItWorks.title }}</h2>
                <p class="section-sub text-muted">{{ page.howItWorks.subtitle }}</p>
            </div>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 justify-content-center">
                {% for step in page.howItWorks.steps %}
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm text-center">
                        <div class="card-body p-4">
                            <div class="step-badge brand-gradient text-white mx-auto mb-4">{{ step.number }}</div>
                            <h5 class="fw-semibold mb-3">{{ step.title }}</h5>
                            <p class="text-muted mb-0">{{ step.description }}</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Market Context -->
    <section class="py-5 bg-white">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title fw-bold mb-2">{{ page.credibility.title }}</h2>
                <p class="section-sub text-muted">{{ page.credibility.subtitle }}</p>
            </div>
            <div class="row row-cols-1 row-cols-md-2 g-4 justify-content-center">
                {% for point in page.credibility.points %}
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h5 class="fw-semibold brand-text mb-3">{{ point.title }}</h5>
                            <p class="text-muted mb-0">{{ point.description }}</p>
                        </div>
                        <div class="brand-card-bar"></div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-5 brand-gradient text-white text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-7">
                    <h2 class="fw-bold mb-3">Your Title Deserves a Global Audience</h2>
                    <p class="mb-5 opacity-75">Vaizen is launching soon. Tell us about yourself and we'll keep you updated.</p>
                    <a href="#contact-modal" class="btn btn-light btn-lg px-5 py-3 fw-semibold brand-cta-btn">Want to Know More?</a>
                </div>
            </div>
        </div>
    </section>

{% endblock %}
