{% extends "_layout.njk" %}

{% block content %}

    <!-- Hero -->
    <section class="hero-section">
        <div class="container">
            <div class="row">
                <div class="col-lg-7 col-xl-6">
                    <h1 class="hero-heading mb-4">
                        {{ page.hero.line1 | default("Acquisition,") }}<br>
                        <span class="hero-heading-accent">{{ page.hero.line2 | default("reimagined.") }}</span>
                    </h1>
                    <p class="hero-sub mb-5">{{ page.hero.description }}</p>
                    <div class="d-flex gap-3 flex-wrap">
                        <button class="btn btn-brand btn-lg px-4 py-2" data-bs-toggle="modal" data-bs-target="#contactModal">Browse the catalog</button>
                        <button class="btn btn-hero-outline btn-lg px-4 py-2" data-bs-toggle="modal" data-bs-target="#contactModal">Learn more</button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- From Search to Screening -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title fw-bold mb-2">{{ page.model.title }}</h2>
                <p class="section-sub text-muted">{{ page.model.subtitle }}</p>
            </div>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 justify-content-center">
                {% for step in page.model.steps %}
                <div class="col">
                    <div class="card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="step-badge mx-auto mb-4">{{ step.number }}</div>
                            <h5 class="fw-semibold mb-3">{{ step.title }}</h5>
                            <p class="text-muted mb-0">{{ step.description }}</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Built for Professional Acquisition -->
    <section class="py-5 bg-white">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title fw-bold mb-2">{{ page.benefits.title }}</h2>
                <p class="section-sub text-muted">{{ page.benefits.subtitle }}</p>
            </div>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 justify-content-center">
                {% for benefit in page.benefits.items %}
                <div class="col">
                    <div class="card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="benefit-emoji mb-3">{{ benefit.icon }}</div>
                            <h5 class="fw-semibold mb-3">{{ benefit.title }}</h5>
                            <p class="text-muted mb-0">{{ benefit.description }}</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Old vs New -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title fw-bold mb-2">{{ page.risk.title }}</h2>
                <p class="section-sub text-muted">{{ page.risk.subtitle }}</p>
            </div>
            <div class="row row-cols-1 row-cols-md-3 g-4 justify-content-center">
                {% for comparison in page.risk.comparisons %}
                <div class="col">
                    <div class="card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="benefit-emoji mb-3">{{ comparison.icon }}</div>
                            <h5 class="fw-semibold mb-3">{{ comparison.title }}</h5>
                            <p class="text-muted mb-0">{{ comparison.description }}</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Search Dimensions -->
    <section class="py-5 bg-white">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title fw-bold mb-2">{{ page.metrics.title }}</h2>
                <p class="section-sub text-muted">{{ page.metrics.subtitle }}</p>
            </div>
            <div class="row row-cols-1 row-cols-md-3 g-4 justify-content-center">
                {% for metric in page.metrics.items %}
                <div class="col">
                    <div class="card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="benefit-emoji mb-3">{{ metric.icon }}</div>
                            <h5 class="fw-semibold mb-3">{{ metric.name }}</h5>
                            <p class="text-muted mb-3">{{ metric.description }}</p>
                            {% if metric.insight %}
                            <div class="insight-chip text-start">{{ metric.insight }}</div>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Traditional vs Vaizen -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title fw-bold mb-2">{{ page.comparison.title }}</h2>
                <p class="section-sub text-muted">{{ page.comparison.subtitle }}</p>
            </div>
            <div class="row row-cols-1 row-cols-md-2 g-4 justify-content-center">
                {% for model in page.comparison.models %}
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body p-4">
                            <h5 class="fw-semibold mb-3 pb-3 border-bottom" style="border-color: var(--divider) !important;">{{ model.name }}</h5>
                            <ul class="comparison-list mb-0">
                                {% for point in model.points %}
                                <li class="py-2 border-bottom text-muted">
                                    <span class="me-2">{{ model.icon }}</span>{{ point }}
                                </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-5 cta-section text-white text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-7">
                    <h2 class="fw-bold mb-3">Acquisition, Reimagined</h2>
                    <p class="mb-5 opacity-75">Vaizen is launching soon. Register your interest and be among the first buyers on the platform when we open the doors.</p>
                    <button class="btn btn-brand btn-lg px-5 py-3" data-bs-toggle="modal" data-bs-target="#contactModal">Want to Know More?</button>
                </div>
            </div>
        </div>
    </section>

{% endblock %}
