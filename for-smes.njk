{% extends "_layout.njk" %}

{% block content %}
    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <h1>{{ page.hero.heading }}</h1>
            <p>{{ page.hero.description }}</p>
            <div class="hero-buttons">
                {% for button in page.hero.buttons %}
                <a href="{{ button.url }}" class="{{ button.class }}">{{ button.text }}</a>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Problem Section -->
    <section class="how-it-works">
        <div class="container">
            <h2 class="section-title">{{ page.problem.title }}</h2>
            <p class="section-subtitle">{{ page.problem.subtitle }}</p>
            
            <div class="steps">
                {% for challenge in page.problem.challenges %}
                <div class="step">
                    <div class="step-icon">{{ challenge.icon }}</div>
                    <h3>{{ challenge.title }}</h3>
                    <p>{{ challenge.description }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Solution Section -->
    <section class="featured-brands">
        <div class="container">
            <h2 class="section-title">{{ page.solution.title }}</h2>
            <p class="section-subtitle">{{ page.solution.subtitle }}</p>
            
            <div class="benefits-grid">
                {% for benefit in page.solution.benefits %}
                <div class="benefit-card">
                    <div class="benefit-icon">{{ benefit.icon }}</div>
                    <h3>{{ benefit.title }}</h3>
                    <p>{{ benefit.description }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Two Critical Variables -->
    <section class="how-it-works">
        <div class="container">
            <h2 class="section-title">{{ page.variables.title }}</h2>
            <p class="section-subtitle">{{ page.variables.subtitle }}</p>
            
            <div class="steps">
                {% for variable in page.variables.items %}
                <div class="step">
                    <div class="step-icon">{{ variable.number }}</div>
                    <h3>{{ variable.title }}</h3>
                    <p>{{ variable.description }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Metrics Section -->
    <section class="benefits" id="metrics">
        <div class="container">
            <h2 class="section-title">{{ page.metrics.title }}</h2>
            <p class="section-subtitle">{{ page.metrics.subtitle }}</p>
            
            <div class="benefits-grid">
                {% for metric in page.metrics.items %}
                <div class="benefit-card">
                    <div class="benefit-icon">{{ metric.icon }}</div>
                    <h3>{{ metric.name }}</h3>
                    <p>{{ metric.description }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
        <div class="container">
            <h2>Ready to Build Your Brand?</h2>
            <p>Access brand-building capital without operational interference or excessive dilution</p>
            <div class="hero-buttons">
                <a href="#" class="btn-primary">Apply Now</a>
                <a href="#" class="btn-secondary">Learn More</a>
            </div>
        </div>
    </section>
{% endblock %}
