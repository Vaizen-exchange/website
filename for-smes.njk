{% extends "_layout.njk" %}

{% block content %}

    <!-- Hero -->
    <section class="hero-section brand-gradient text-white text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 col-xl-7">
                    <h1 class="hero-heading fw-bold mb-4">{{ page.hero.heading }}</h1>
                    <p class="hero-sub mb-5">{{ page.hero.description }}</p>
                    <div class="d-flex gap-3 justify-content-center flex-wrap">
                        {% for button in page.hero.buttons %}
                        <a href="{{ button.url }}" class="btn btn-light btn-lg px-5 py-3 fw-semibold brand-cta-btn">{{ button.text }}</a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- The Problem -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title fw-bold mb-2">{{ page.problem.title }}</h2>
                <p class="section-sub text-muted">{{ page.problem.subtitle }}</p>
            </div>
            <div class="row row-cols-1 row-cols-md-3 g-4 justify-content-center">
                {% for challenge in page.problem.challenges %}
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm text-center">
                        <div class="card-body p-4">
                            <div class="step-badge brand-gradient text-white mx-auto mb-4">{{ challenge.icon }}</div>
                            <h5 class="fw-semibold mb-3">{{ challenge.title }}</h5>
                            <p class="text-muted mb-0">{{ challenge.description }}</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- The Solution -->
    <section class="py-5 bg-white">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title fw-bold mb-2">{{ page.solution.title }}</h2>
                <p class="section-sub text-muted">{{ page.solution.subtitle }}</p>
            </div>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 justify-content-center">
                {% for benefit in page.solution.benefits %}
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm text-center">
                        <div class="card-body p-4">
                            <div class="benefit-emoji mb-3">{{ benefit.icon }}</div>
                            <h5 class="fw-semibold mb-3">{{ benefit.title }}</h5>
                            <p class="text-muted mb-0">{{ benefit.description }}</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Supply & Demand -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title fw-bold mb-2">{{ page.variables.title }}</h2>
                <p class="section-sub text-muted">{{ page.variables.subtitle }}</p>
            </div>
            <div class="row row-cols-1 row-cols-md-2 g-4 justify-content-center">
                {% for variable in page.variables.items %}
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm text-center">
                        <div class="card-body p-4">
                            <div class="step-badge brand-gradient text-white mx-auto mb-4">{{ variable.number }}</div>
                            <h5 class="fw-semibold mb-3">{{ variable.title }}</h5>
                            <p class="text-muted mb-0">{{ variable.description }}</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- The Signals -->
    <section class="py-5 bg-white">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title fw-bold mb-2">{{ page.metrics.title }}</h2>
                <p class="section-sub text-muted">{{ page.metrics.subtitle }}</p>
            </div>
            <div class="row row-cols-1 row-cols-md-3 g-4 justify-content-center">
                {% for metric in page.metrics.items %}
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm text-center">
                        <div class="card-body p-4">
                            <div class="benefit-emoji mb-3">{{ metric.icon }}</div>
                            <h5 class="fw-semibold mb-3">{{ metric.name }}</h5>
                            <p class="text-muted mb-0">{{ metric.description }}</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-5 brand-gradient text-white text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-7">
                    <h2 class="fw-bold mb-3">The Next Great Content Company Isn't a Studio</h2>
                    <p class="mb-5 opacity-75">It's the marketplace the studios can't afford to ignore. Vaizen is built, functional, and ready to scale.</p>
                    <a href="#contact-modal" class="btn btn-light btn-lg px-5 py-3 fw-semibold brand-cta-btn">Want to Know More?</a>
                </div>
            </div>
        </div>
    </section>

{% endblock %}
